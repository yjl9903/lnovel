{
  "name": "@lnovel/server",
  "version": "0.0.4",
  "private": true,
  "description": "lnovel api server",
  "keywords": [
    "light-novels"
  ],
  "homepage": "https://github.com/yjl9903/lnovel#readme",
  "bugs": {
    "url": "https://github.com/yjl9903/lnovel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjl9903/lnovel.git"
  },
  "license": "AGPL-3.0",
  "author": "XLor",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./logging": {
      "types": "./dist/logging.d.mts",
      "import": "./dist/logging.mjs"
    }
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "lnovel-server": "./cli.mjs"
  },
  "files": [
    "*.mjs",
    "dist",
    "drizzle"
  ],
  "scripts": {
    "browser:prepare": "cloakbrowser install",
    "build": "tsdown",
    "drizzle": "drizzle-kit",
    "drizzle:generate": "drizzle-kit generate",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "bilinovel": "workspace:*",
    "breadc": "1.0.0-beta.18",
    "cloakbrowser": "0.5.10",
    "croner": "10.0.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "drizzle-sqlite": "^0.1.0",
    "feed": "6.0.0",
    "flomise": "0.0.6",
    "hono": "4.13.7",
    "lnovel": "workspace:*",
    "lru-cache": "11.5.2",
    "playwright-core": "1.62.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  },
  "engines": {
    "node": ">=v24.0.0"
  }
}
